# Copy this file to `.env` and fill in your own values. `.env` is gitignored
#
#   cp .env.example .env

# --- External APIs ---------------------------------------------------------
# Both are free. Without a key the provider is simply skipped and its media
# types show up as disabled in the search (AniList and OpenLibrary need no key).

# TMDB (movies & series): use the "API Read Access Token" (the long JWT-style
# token), NOT the short "API Key" – it is sent as a Bearer header.
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# RAWG (games): https://rawg.io/apidocs
RAWG_API_KEY=

# --- Port (optional) -------------------------------------------------------
# The app is served on http://localhost:8580 by default. Change it if that
# port is already taken on your machine.
# APP_PORT=8580

# --- Version (optional, only for docker-compose.prod.yml) -----------------
# Which release of the prebuilt images to run, e.g. 0.2.0. Default: latest.
# MEDIASYSTEM_VERSION=latest

# --- Database (optional) ---------------------------------------------------
# The defaults below are what docker-compose.yml and the backend use when
# nothing is set. Only change them if you need to; keep both sides in sync.
# POSTGRES_DB=mediasystem
# POSTGRES_USER=mediasystem
# POSTGRES_PASSWORD=mediasystem
# POSTGRES_PORT=5432
# DB_URL=jdbc:postgresql://localhost:5432/mediasystem
# DB_USERNAME=mediasystem
# DB_PASSWORD=mediasystem
